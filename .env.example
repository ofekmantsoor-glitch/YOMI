# Copy to .env.local and fill from Supabase → Project Settings → API. Never commit .env.local.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Local only: used by scripts/demo-reset.mjs and e2e tests. Never in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Local only: password for the demo therapist accounts created by demo:reset.
DEMO_PASSWORD=
